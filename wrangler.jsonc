// Cloudflare deploy (free plan): the static export in ./out served as Workers
// static assets, plus a small Worker for the project brief form at /api/lead.
// Build with `npm run build:cf`, deploy with `npx wrangler deploy`.
// See CLOUDFLARE.md for the dashboard steps.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caide",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Briefs are stored here. Read them in the dashboard: Storage & Databases > D1 > caide-leads.
  "d1_databases": [
    { "binding": "DB", "database_name": "caide-leads", "database_id": "84dbf983-75b1-4c28-b650-b65c0fff1d8c" }
  ],
  // At most 5 brief submissions per minute per visitor IP (per Cloudflare location).
  "ratelimits": [
    { "name": "LEAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
  // With a custom domain later:
  // - "vars": { "ALLOWED_ORIGIN": "https://<domain>", "LEAD_FROM": "briefs@<domain>", "LEAD_TO": "<verified inbox>" }
  // - "send_email": [{ "name": "EMAIL", "destination_address": "<verified inbox>" }]
  // Secret (never in this file): `npx wrangler secret put TURNSTILE_SECRET`
}
